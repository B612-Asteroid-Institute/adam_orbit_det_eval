data/sim_products/isolation_study_neo100_20260403/AA*/
data/sim_products/phase1_assist/
data/sim_products/phase1_constant_bias/
# MPC-scale bias-run inputs (shard parquets + manifest); re-fetched via scripts/15_fetch_mpc_scale.py
data/mpc_scale_*/
# Pilot validation outputs (local integration tests)
data/pilot_validation/
# EFCC18 debiasing cache (regenerable from debias_2018.tgz via scripts/preprocess_efcc18.py)
data/efcc18/

