# Production overlay image for MPC-scale real-data LOOO cloud run.
#
# Layers workspace adam_core, adam_fo, adam_orbit_det_eval on top of the
# isolation study base image, builds Find_Orb (binary + ephemerides), and
# validates with a build-time end-to-end smoke test.
#
# The base image (mpc-isolation-study, Debian Trixie, Python 3.11) supplies:
#   build-essential (GCC 14), ASSIST, google-cloud-storage, all transitive deps.
# It does NOT include the Find_Orb binary or JPL ephemeris files.
#
# Find_Orb's pinned commits have a missing header declaration (bead mxw):
# ades_out.cpp references get_satellite_offset() which is only forward-declared
# in mpc_obs.cpp, not in mpc_obs.h. We patch the header before compiling.
#
# Build (from workspace root):
#   docker build -f adam_orbit_det_eval/infra/exp-research/Dockerfile.production \
#     -t mpc-real-data-looo:v10-local /Users/kathleenkiker/beads_agent_setup
#
# Push:
#   TAG=us-west1-docker.pkg.dev/moeyens-thor-dev/ai/mpc-real-data-looo:pilot-v10-$(date -u +%Y%m%d)
#   docker tag mpc-real-data-looo:v10-local $TAG
#   docker push $TAG
#
FROM us-west1-docker.pkg.dev/moeyens-thor-dev/ai/mpc-isolation-study:latest-20260409170834

WORKDIR /app

# --- Install build deps for Find_Orb compilation ---
# Base image has build-essential + GCC 14 but lacks git and wget.
RUN apt-get update && apt-get install -y --no-install-recommends git wget zlib1g-dev libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

# --- Build Find_Orb from source (pinned for reproducibility) ---
# Find_Orb dependency SHAs pinned 2026-06-16 after lunar PREFIX drift broke a
# floating-HEAD build. Refresh by re-pinning to fresh HEADs after verifying a
# clean build.
#
# Why PREFIX: lunar HEAD changed its makefile default to `PREFIX ?= ..` (installs
# headers to ../include) while jpl_eph still compiles with `-I ~/include`; with
# floating HEAD the two diverged and get_bin.h landed where jpl_eph couldn't see
# it. Exporting PREFIX=$HOME forces every Bill-Gray makefile to a single prefix
# (/root/{include,lib,bin}), restoring the layout the green pilots (v10–v12) used.
# These pinned find_orb sources already carry the bead-mxw get_satellite_offset
# fix upstream, so no header patch is needed (verified: clean `make fo` under
# the base image's GCC 14, all the way through mpc_obs.cpp / ades_out.cpp).
ENV FO_BUILD_DIR=/root/.local/share/adam_fo
RUN set -ex && export PREFIX="$HOME" \
    && mkdir -p $FO_BUILD_DIR && cd $FO_BUILD_DIR && mkdir -p find_orb && cd find_orb \
    && git clone https://github.com/Bill-Gray/lunar.git    && git -C lunar    checkout 7ee6739196dcfdc1e7924a864c5103bfa408b6ca \
    && git clone https://github.com/Bill-Gray/jpl_eph.git   && git -C jpl_eph   checkout 0c2782e86e42df69a55c2b2db0b72a40312c79c0 \
    && git clone https://github.com/Bill-Gray/sat_code.git  && git -C sat_code  checkout ff7b98957dfa2979700a482bde9de9542807293e \
    && git clone https://github.com/Bill-Gray/find_orb.git  && git -C find_orb  checkout b36535b2558ff0cab9774c0925cecca97a43bb95 \
    && git clone https://github.com/Bill-Gray/miscell.git   && git -C miscell   checkout 9ba48b37f26b3ec762aa47c2fc941ef74c1323aa \
    # Build in dependency order
    && cd lunar   && make liblunar.a && make install && cd .. \
    && cd jpl_eph && make libjpl.a   && make install && cd .. \
    && cd lunar   && make integrat   && make install && cd .. \
    && cd sat_code && make sat_id    && make install && cd .. \
    && cd find_orb && make fo        && make install && cd .. \
    # Download JPL ephemeris files
    && mkdir -p $FO_BUILD_DIR/find_orb/.find_orb \
    && cd $FO_BUILD_DIR/find_orb/.find_orb \
    && wget -q https://ssd.jpl.nasa.gov/ftp/eph/planets/Linux/de440t/linux_p1550p2650.440t \
    && wget -qO bc405.dat https://storage.googleapis.com/asteroid-institute-data/ephemeris/bc405.dat

# --- Stage Find_Orb's config files into the config dir ---
# The pinned find_orb (b36535b) hard-asserts in default_config_dir_name()
# (miscell.cpp:212, test_ifile) that ~/.find_orb — the symlink target below —
# holds a valid config file (cospar.txt). With only the ephemerides present
# (the wget above), `fo` aborts with SIGABRT (rc 134) on every object, which the
# build-time smoke catches. `make install` (PREFIX=$HOME) staged the config set
# under $HOME/share/findorb/data; copy it alongside the ephemerides. Kept as a
# separate RUN so the Find_Orb compile layer above stays cache-valid.
RUN cp -a /root/share/findorb/data/. /root/.local/share/adam_fo/find_orb/.find_orb/

# --- Symlink config dir so fo's default_config_dir_name() finds cospar.txt ---
# fo probes ~/.find_orb/cospar.txt at startup; the RUNs above stage both the
# ephemerides and the find_orb config files under $FO_BUILD_DIR/find_orb/.find_orb/.
RUN ln -s /root/.local/share/adam_fo/find_orb/.find_orb /root/.find_orb

# --- Overlay workspace adam_core (fixes refine_fit ABC mismatch) ---
COPY adam_core/ /app/adam_core/
RUN cd /app/adam_core && PDM_BUILD_SCM_VERSION=99.0.0 pip install --no-cache-dir --no-deps .

# --- Reinstall workspace adam_fo WITH deps (registers build-fo, config paths) ---
COPY adam_fo/ /app/adam_fo/
RUN cd /app/adam_fo && PDM_BUILD_SCM_VERSION=99.0.0 pip install --no-cache-dir --no-deps .

# --- Overlay workspace adam_orbit_det_eval (all bug fixes) ---
COPY adam_orbit_det_eval/ /app/adam_orbit_det_eval/
RUN cd /app/adam_orbit_det_eval && pip install --no-cache-dir --no-deps .

# --- Import-level smoke tests (fast) ---
RUN python -c "from adam_fo.find_orb_orbit_fitter import FindOrbOrbitFitter; f = FindOrbOrbitFitter(fo_result_dir='/tmp/fo_smoke'); print('findorb instantiation OK')"
RUN python -c "from adam_orbit_det_eval.looo.pipeline import run_looo_pipeline; print('pipeline import OK')"
RUN python -c "from adam_assist import ASSISTPropagator; print('assist import OK')"

# --- Verify Find_Orb artifacts exist ---
RUN python -c "\
from adam_fo.config import LINUX_JPL_PATH, BC405_FILENAME, FO_BINARY_DIR; \
assert LINUX_JPL_PATH.exists(), f'DE440t not found at {LINUX_JPL_PATH}'; \
assert BC405_FILENAME.exists(), f'bc405.dat not found at {BC405_FILENAME}'; \
print(f'DE440t: {LINUX_JPL_PATH} ({LINUX_JPL_PATH.stat().st_size / 1e6:.0f} MB)'); \
print(f'bc405:  {BC405_FILENAME} ({BC405_FILENAME.stat().st_size / 1e6:.0f} MB)'); \
print('find_orb artifacts OK')"

# --- Build-time E2E smoke test (the gate) ---
# Runs the full LOOO pipeline on a 2-object fixture and verifies non-empty output.
# If this fails, the build fails and no image is pushed.
COPY adam_orbit_det_eval/tests/fixtures/smoke_obs.parquet /app/fixtures/smoke_obs.parquet
COPY adam_orbit_det_eval/tests/fixtures/smoke_orbits.parquet /app/fixtures/smoke_orbits.parquet
COPY adam_orbit_det_eval/tests/fixtures/smoke_test_pipeline.py /app/fixtures/smoke_test_pipeline.py
RUN python /app/fixtures/smoke_test_pipeline.py

ENTRYPOINT ["python", "/app/adam_orbit_det_eval/scripts/12_run_looo_cloud_shard.py"]
