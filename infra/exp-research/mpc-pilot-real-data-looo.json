{
  "name": "mpc-pilot-real-data-looo",
  "namespace": "research",
  "queue": "cpu-ondemand",
  "mode": "indexed",
  "image": "us-west1-docker.pkg.dev/moeyens-thor-dev/ai/mpc-real-data-looo:pilot-v10-20260423",
  "resources": {
    "cpu": "6",
    "memory": "24Gi",
    "gpu": 0
  },
  "job": {
    "completions": 4,
    "parallelism": 4,
    "ttl_seconds_after_finished": 172800
  },
  "retry": {
    "backoff_limit_per_index": 2,
    "max_failed_indexes": 1
  },
  "outputs": {
    "gcs_prefix": "gs://exp-research/mpc-real-data-looo-pilot"
  },
  "command": [
    "python",
    "/app/adam_orbit_det_eval/scripts/12_run_looo_cloud_shard.py",
    "--gcs-input-prefix", "gs://exp-research/mpc-real-data-looo-pilot/input",
    "--gcs-output-prefix", "gs://exp-research/mpc-real-data-looo-pilot/output",
    "--propagator", "assist",
    "--orbit-fitter", "findorb",
    "--strict-fitter",
    "--max-processes", "4"
  ]
}
